{
  "name": "@milton/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "bun --no-env-file scripts/build.ts",
    "check-types": "tsc --noEmit",
    "test:integration": "node --experimental-strip-types scripts/integration.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:provision": "node --experimental-strip-types scripts/provision.ts",
    "format:check": "prettier --check src scripts test README.md package.json tsconfig.json"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/core": "1.7.18",
    "@better-auth/kysely-adapter": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@dotenvx/dotenvx": "2.38.2",
    "@hono/node-server": "2.1.5",
    "@milton/theme": "workspace:*",
    "better-auth": "1.7.18",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "typescript": "catalog:"
  }
}
