---
import { memoExample } from "./memo-example";
---

<figure
  class="memo-demo sheet"
  id="memo-demo"
  data-memo-demo
  aria-label="Example conversation."
>
  {/* Animated, the header shows a visual copy of the active scene's label. Each
      scene keeps its own label as its accessible name, so this copy stays
      aria-hidden. Static, the bar is hidden and each scene shows its label. */}
  <div class="sheet-bar">
    <span class="scene-names" aria-hidden="true">
      <span class="scene-name-stack">
        {memoExample.scenes.map((scene) => (
          <span class="scene-name" data-scene-name>
            {scene.label}
          </span>
        ))}
      </span>
    </span>
    <span data-scene-progress aria-hidden="true"></span>
  </div>
  <div class="scene-stage sheet-content">
    {memoExample.scenes.map((scene, index) => (
      <section
        class="scene"
        id={`memo-scene-${index}`}
        data-scene
        aria-labelledby={`memo-scene-${index}-label`}
      >
        <p class="scene-label eyebrow" id={`memo-scene-${index}-label`}>
          {scene.label}
        </p>
        <ol class="chat">
          {scene.turns.map((turn) => (
            <li>
              <span class="speaker">{turn.speaker}</span>
              {turn.text && <p data-stream>{turn.text}</p>}
              {turn.excerpt && (
                <blockquote class="excerpt">
                  <p data-stream>{turn.excerpt.body}</p>
                  {turn.excerpt.signature && (
                    <p data-stream>{turn.excerpt.signature}</p>
                  )}
                </blockquote>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <div class="demo-controls" data-demo-controls hidden>
    <button
      class="secondary"
      type="button"
      data-playback
      aria-controls="memo-demo"
      aria-label="Pause animation"
    >
      Pause
    </button>
    <button
      class="secondary"
      type="button"
      data-replay
      aria-controls="memo-demo"
      aria-label="Replay animation"
    >
      Replay
    </button>
    <span class="playback-status" data-playback-status role="status"></span>
  </div>
</figure>

<script>
  const demo = document.querySelector<HTMLElement>("[data-memo-demo]");
  if (demo) {
    const story = demo.querySelector<HTMLElement>(".scene-stage")!;
    const controls = demo.querySelector<HTMLElement>("[data-demo-controls]")!;
    const toggle = demo.querySelector<HTMLButtonElement>("[data-playback]")!;
    const replay = demo.querySelector<HTMLButtonElement>("[data-replay]")!;
    const status = demo.querySelector<HTMLElement>("[data-playback-status]")!;
    const progress = demo.querySelector<HTMLElement>("[data-scene-progress]")!;
    const names = Array.from(
      demo.querySelectorAll<HTMLElement>("[data-scene-name]"),
    );
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    // The complete semantic story stays intact. Only this hidden-from-AT copy
    // types or switches scenes, so no typed characters are announced.
    const visual = story.cloneNode(true) as HTMLElement;
    visual.className = "motion-story sheet-content";
    visual.setAttribute("aria-hidden", "true");
    visual
      .querySelectorAll("[id]")
      .forEach((node) => node.removeAttribute("id"));
    visual
      .querySelectorAll("[aria-labelledby]")
      .forEach((node) => node.removeAttribute("aria-labelledby"));
    controls.before(visual);
    const panels = Array.from(visual.querySelectorAll<HTMLElement>(".scene"));
    const messages = panels.map((panel) =>
      Array.from(panel.querySelectorAll<HTMLElement>(".chat > li")).map(
        (unit) => {
          const lines = Array.from(
            unit.querySelectorAll<HTMLElement>("[data-stream]"),
          ).map((paragraph) => {
            const text = paragraph.textContent ?? "";
            // The full copy reserves each line's final height while typing.
            const source = document.createElement("span");
            source.className = "stream-source";
            source.textContent = text;
            const copy = document.createElement("span");
            copy.className = "stream-visual";
            paragraph.classList.add("stream-line");
            paragraph.replaceChildren(source, copy);
            return { text, copy };
          });
          return { unit, lines };
        },
      ),
    );

    const scene2Start = 5800;
    const cues = [
      [
        { at: 0, type: 0 },
        { at: 450, type: 650 },
        { at: 1500, type: 0 },
        { at: 3200, type: 450 },
      ],
      [
        { at: scene2Start, type: 0 },
        { at: scene2Start + 250, type: 320 },
        { at: scene2Start + 900, type: 0 },
        { at: scene2Start + 1950, type: 600 },
      ],
    ];
    const finalCue = cues[1][3];
    const duration = finalCue.at + finalCue.type;
    let elapsed = 0;
    let playing = true;
    let visible = false;
    let frame = 0;
    let last: number | null = null;

    const render = () => {
      const scene = elapsed < scene2Start ? 0 : 1;
      names.forEach((name, index) =>
        name.classList.toggle("active", index === scene),
      );
      progress.textContent = `${scene + 1} / ${panels.length}`;
      panels.forEach((panel, index) =>
        panel.classList.toggle("active", index === scene),
      );
      messages.forEach((items, index) =>
        items.forEach(({ unit, lines }, turn) => {
          const cue = cues[index][turn];
          unit.classList.toggle("pending", elapsed < cue.at);
          const fraction = cue.type
            ? Math.max(0, Math.min(1, (elapsed - cue.at) / cue.type))
            : 1;
          let remaining = Math.ceil(
            lines.reduce((length, line) => length + line.text.length, 0) *
              fraction,
          );
          lines.forEach(({ text, copy }) => {
            copy.textContent = text.slice(0, Math.max(0, remaining));
            remaining -= text.length;
          });
        }),
      );
    };
    const announce = () => {
      const ended = elapsed >= duration;
      toggle.textContent = ended ? "Complete" : playing ? "Pause" : "Play";
      toggle.setAttribute(
        "aria-label",
        ended
          ? "Animation complete"
          : playing
            ? "Pause animation"
            : "Play animation",
      );
      toggle.setAttribute("aria-disabled", String(ended));
      status.textContent = ended
        ? "Complete"
        : !playing
          ? "Paused"
          : visible && !document.hidden
            ? "Playing"
            : "Waiting";
    };
    const advance = (now: number) => {
      // A frame's timestamp can precede schedule's performance.now(). Keep the
      // clock monotonic, including the first frame after Replay or resume.
      const current = Math.max(now, last ?? now);
      if (last !== null) elapsed = Math.min(duration, elapsed + current - last);
      last = current;
      render();
    };
    const tick = (now: number) => {
      advance(now);
      if (elapsed < duration) frame = requestAnimationFrame(tick);
      else {
        playing = false;
        last = null;
        announce();
      }
    };
    const schedule = () => {
      cancelAnimationFrame(frame);
      last = null;
      if (
        playing &&
        visible &&
        !reduced.matches &&
        !document.hidden &&
        elapsed < duration
      ) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
      announce();
    };
    toggle.addEventListener("click", () => {
      if (elapsed >= duration) return;
      if (last !== null) advance(performance.now());
      playing = !playing;
      schedule();
    });
    replay.addEventListener("click", () => {
      elapsed = 0;
      playing = true;
      render();
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    let observer: IntersectionObserver | undefined;
    let requiredVisibility = 0.35;
    const observeVisibility = () => {
      const maximum = Math.min(
        1,
        document.documentElement.clientHeight /
          demo.getBoundingClientRect().height,
      );
      // Keep 35% unless the viewport cannot show that much of the card. In that
      // case require 80% of the available viewport, still observed before play.
      const threshold = maximum < 0.35 ? 0.8 * maximum : 0.35;
      if (observer && threshold === requiredVisibility) return;
      observer?.disconnect();
      requiredVisibility = threshold;
      visible = false;
      schedule();
      observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[entries.length - 1];
          visible =
            entry.isIntersecting && entry.intersectionRatio >= threshold;
          schedule();
        },
        { threshold },
      );
      observer.observe(demo);
    };
    const resize = new ResizeObserver(observeVisibility);
    resize.observe(demo, { box: "border-box" });
    window.addEventListener("resize", observeVisibility);
    const preference = () => {
      demo.classList.toggle("enhanced", !reduced.matches);
      controls.hidden = reduced.matches;
      observeVisibility();
      schedule();
    };
    reduced.addEventListener("change", preference);
    render();
    preference();
  }
</script>

<style>
  .memo-demo {
    margin: 0;
    min-width: 0;
  }
  .stream-line {
    position: relative;
  }
  .stream-line :global(.stream-source) {
    visibility: hidden;
  }
  .stream-line :global(.stream-visual) {
    display: block;
    position: absolute;
    inset: 0;
  }
  .enhanced :global(.pending) {
    visibility: hidden;
  }
  .scene-stage {
    display: grid;
    gap: var(--space-8);
  }
  .scene {
    min-width: 0;
  }
  .motion-story {
    display: none;
  }
  .enhanced .motion-story {
    display: grid;
  }
  /* Animated, the header names the active scene and each scene's own label is
     kept for assistive technology only. Static, each scene shows its label. */
  .memo-demo:not(.enhanced) .sheet-bar {
    display: none;
  }
  .scene-name-stack {
    display: inline-grid;
  }
  .scene-name {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .scene-name.active {
    visibility: visible;
  }
  .enhanced > .scene-stage,
  .motion-story .scene-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .motion-story .scene {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .motion-story .scene.active {
    visibility: visible;
  }
  .chat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .chat > li {
    border-left: 2px solid var(--hairline);
    padding: 0 var(--space-4);
  }
  .scene-label {
    margin-bottom: var(--space-3);
  }
  /* A saved-report excerpt, set like a sample on a report: typed text in a
     dashed box on the ground, apart from the chat turns around it. */
  .excerpt {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--hairline);
    background: var(--ground);
    font: var(--text-small) / var(--leading-body) var(--font-mono);
  }
  p + .excerpt {
    margin-top: var(--space-3);
  }
  .excerpt > p + p {
    margin-top: var(--space-2);
  }
  .speaker {
    display: block;
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
    margin-bottom: var(--space-2);
  }
  p {
    margin: 0;
    text-wrap: pretty;
  }
  .demo-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--sheet-padding);
    border-top: 1px solid var(--hairline);
  }
  .demo-controls[hidden] {
    display: none;
  }
  .demo-controls button {
    min-height: var(--touch-target);
    padding: var(--space-2) var(--space-4);
  }
  .demo-controls button[aria-disabled="true"] {
    color: var(--muted);
    border-color: var(--muted);
    background: var(--ground);
    cursor: default;
  }
  .playback-status {
    flex-basis: 100%;
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
  }
</style>
