---
import { memoExample } from "./memo-example";
import { compareWords } from "./edit-score";

const outputs = memoExample.outputs.map((output) => ({
  ...output,
  score: compareWords(memoExample.original, output.text),
}));
---

<figure
  class="memo-demo sheet"
  id="memo-demo"
  data-memo-demo
  aria-labelledby="memo-demo-title"
  aria-describedby="memo-demo-scope memo-demo-method"
>
  <figcaption class="sheet-bar" id="memo-demo-title">
    TPS memo · One cleanup request
  </figcaption>
  <div class="demo-content sheet-content">
    <p class="demo-scope small-note" id="memo-demo-scope">
      An illustration, not a model run or a product guarantee.
    </p>
    <section
      class="original-note"
      data-demo-original-panel
      aria-labelledby="rough-label"
    >
      <h2 class="eyebrow" id="rough-label">
        Your rough draft
      </h2>
      <p class="memo-copy" data-demo-original>
        {memoExample.original}
      </p>
      <p class="cleanup-request">
        <span class="eyebrow">You ask</span>
        <strong>{memoExample.request}</strong>
      </p>
    </section>
    <div class="outputs">
      {outputs.map(({ id, label, score }) => (
        <section class="output" aria-labelledby={id + "-label"}>
          <h3 class="output-title" id={id + "-label"}>
            {label}
          </h3>
          <p class="memo-copy" data-demo-output={id}>
            {score.segments.map((segment) =>
              segment.changed ? (
                <span class="changed-word" data-changed>
                  {segment.text}
                </span>
              ) : (
                segment.text
              ),
            )}
          </p>
          <p
            class="kept-score"
            data-demo-score={id}
            data-kept={score.kept}
            data-total={score.originalWords}
            data-percent={score.percent}
          >
            <strong>{score.percent}%</strong> words kept
            <span class="small-note">
              ({score.kept}/{score.originalWords} original words)
            </span>
          </p>
        </section>
      ))}
    </div>
    <p class="demo-method small-note" id="memo-demo-method">
      Words are letters or numbers, including internal apostrophes. We match the
      longest sequence in the original order, ignoring capitalization and other
      punctuation. Straight and curly apostrophes count alike. Underlines mark
      changed words. Scores describe this illustration only.
    </p>
  </div>
</figure>

<script>
  const demo = document.querySelector<HTMLElement>("[data-memo-demo]");
  if (demo) {
    const original = demo.querySelector<HTMLElement>(
      "[data-demo-original-panel]",
    )!;
    const edits = ["plain", "milton"].map((id) =>
      Array.from(
        demo.querySelectorAll<HTMLElement>(
          '[data-demo-output="' + id + '"] [data-changed]',
        ),
      ),
    );
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const cycleDuration = 10500;
    let elapsed = 0;
    let visible = false;
    let frame = 0;
    let last: number | null = null;

    // Only the paper tint moves. Every word, score and underline stays visible.
    const render = () => {
      original.style.setProperty(
        "--edit-tint",
        reduced.matches
          ? "0%"
          : Math.round(Math.max(0, 1 - elapsed / 1250) * 25) + "%",
      );
      edits.forEach((words, scene) => {
        const start = scene === 0 ? 1250 : 5800;
        const duration = scene === 0 ? 2400 : 2550;
        const progress = (elapsed - start) / duration;
        const band = Math.max(0.1, 2 / words.length);
        words.forEach((word, index) => {
          const center = (index + 0.5) / words.length;
          const strength =
            reduced.matches || progress < 0 || progress > 1
              ? 0
              : Math.max(0, 1 - Math.abs(progress - center) / band);
          word.style.setProperty(
            "--edit-tint",
            Math.round(strength * 100) + "%",
          );
        });
      });
    };
    const tick = (now: number) => {
      const current = Math.max(now, last ?? now);
      if (last !== null) elapsed = (elapsed + current - last) % cycleDuration;
      last = current;
      render();
      frame = requestAnimationFrame(tick);
    };
    const schedule = () => {
      cancelAnimationFrame(frame);
      last = null;
      if (visible && !reduced.matches && !document.hidden) {
        last = performance.now();
        frame = requestAnimationFrame(tick);
      }
    };
    document.addEventListener("visibilitychange", schedule);
    let observer: IntersectionObserver | undefined;
    let requiredVisibility = 0.35;
    const observeVisibility = () => {
      const maximum = Math.min(
        1,
        document.documentElement.clientHeight /
          demo.getBoundingClientRect().height,
      );
      // Adapt only when 35% is physically unreachable; require 80% of the
      // available viewport before animating the taller comparison.
      const threshold = maximum < 0.35 ? 0.8 * maximum : 0.35;
      if (observer && threshold === requiredVisibility) return;
      observer?.disconnect();
      requiredVisibility = threshold;
      visible = false;
      schedule();
      observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[entries.length - 1];
          visible =
            entry.isIntersecting && entry.intersectionRatio >= threshold;
          schedule();
        },
        { threshold },
      );
      observer.observe(demo);
    };
    const resize = new ResizeObserver(observeVisibility);
    resize.observe(demo, { box: "border-box" });
    window.addEventListener("resize", observeVisibility);
    const preference = () => {
      render();
      observeVisibility();
      schedule();
    };
    reduced.addEventListener("change", preference);
    render();
    preference();
  }
</script>

<style>
  .memo-demo {
    margin: 0;
    min-width: 0;
  }
  .demo-content {
    display: grid;
    gap: var(--space-6);
  }
  .demo-content > p {
    margin: 0;
  }
  .original-note {
    padding: var(--space-5);
    border: 1px dashed var(--hairline);
    background: color-mix(
      in srgb,
      var(--sheet-bar) var(--edit-tint, 0%),
      var(--ground)
    );
  }
  .original-note h2 {
    margin: 0 0 var(--space-3);
  }
  .cleanup-request {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
  .outputs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .output {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-5);
  }
  .output-title {
    margin: 0 0 var(--space-4);
    font: var(--text-lead) / var(--leading-heading) var(--font-mono);
  }
  .memo-copy {
    line-height: var(--leading-document);
  }
  .changed-word {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.17em;
    background: color-mix(
      in srgb,
      var(--sheet-bar) var(--edit-tint, 0%),
      transparent
    );
  }
  .kept-score {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-5);
  }
  .kept-score strong {
    font: var(--text-section) / var(--leading-heading) var(--font-mono);
  }
  .demo-method {
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-5);
  }
  p {
    margin: 0;
    text-wrap: pretty;
  }
  @media (max-width: 767px) {
    .outputs {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .original-note {
      padding: var(--space-4);
    }
  }
</style>
