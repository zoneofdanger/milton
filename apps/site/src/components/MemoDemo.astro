---
import { memoExample } from "./memo-example";
---

<figure
  class="memo-demo sheet"
  id="memo-demo"
  data-memo-demo
  aria-label="Example conversation."
>
  <div class="sheet-bar">
    <span>Did you get that memo?</span>
  </div>
  <div class="scene-stage sheet-content">
    {memoExample.scenes.map((scene, index) => (
      <section
        class="scene"
        id={`memo-scene-${index}`}
        data-scene
        aria-labelledby={`memo-scene-${index}-label`}
      >
        <p class="scene-label eyebrow" id={`memo-scene-${index}-label`}>
          {scene.label}
        </p>
        <ol class="chat">
          {scene.turns.map((turn) => (
            <li>
              <span class="speaker">{turn.speaker}</span>
              {turn.text && <p data-stream>{turn.text}</p>}
              {turn.excerpt && (
                <blockquote class="excerpt">
                  <p data-stream>{turn.excerpt.body}</p>
                  <p data-stream>{turn.excerpt.signature}</p>
                </blockquote>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</figure>

<script>
  const demo = document.querySelector<HTMLElement>("[data-memo-demo]");
  if (demo) {
    const panels = Array.from(
      demo.querySelectorAll<HTMLElement>("[data-scene]"),
    );
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    const messages = panels.map((panel) =>
      Array.from(panel.querySelectorAll<HTMLElement>(".chat > li")).map(
        (unit) => {
          // A message types its lines in order: its text, then any excerpt's body
          // and signature.
          const lines = Array.from(
            unit.querySelectorAll<HTMLElement>("[data-stream]"),
          ).map((paragraph) => {
            const text =
              paragraph.textContent?.replace(/\s+/g, " ").trim() ?? "";
            // Keep the complete text for layout and assistive technology. Only its
            // aria-hidden visual copy types in, so line wrapping never moves the card.
            const source = document.createElement("span");
            source.className = "stream-source";
            source.textContent = text;
            const visual = document.createElement("span");
            visual.className = "stream-visual";
            visual.setAttribute("aria-hidden", "true");
            paragraph.classList.add("stream-line");
            paragraph.replaceChildren(source, visual);
            return { text, visual };
          });
          return { unit, lines };
        },
      ),
    );
    // One typing speed for every character: main's 900 ms per message averaged
    // 30.6 ms per character, rounded up. The holds follow each message.
    const timing = {
      character: 31,
      between: 300,
      scene: 1000,
      end: 1600,
      entrance: 350,
    };
    let scene = 0;
    let message = 0;
    let line = 0;
    let character = 0;
    let sceneComplete = false;
    let inView = false;
    let delay = timing.entrance;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const render = () => {
      panels.forEach((panel, index) => {
        const inactive = !reduced.matches && index !== scene;
        panel.classList.toggle("active", index === scene);
        panel.inert = inactive;
        panel.setAttribute("aria-hidden", String(inactive));
      });
      demo.classList.toggle("enhanced", !reduced.matches);
    };
    const resetScene = () => {
      message = 0;
      line = 0;
      character = 0;
      sceneComplete = false;
      messages[scene].forEach(({ unit, lines }) => {
        unit.classList.add("pending");
        lines.forEach(({ visual }) => (visual.textContent = ""));
      });
      render();
    };
    const schedule = () => {
      clearTimeout(timer);
      if (!reduced.matches && inView && !document.hidden)
        timer = setTimeout(tick, delay);
    };
    const tick = () => {
      if (sceneComplete) {
        scene = (scene + 1) % panels.length;
        resetScene();
      }
      const current = messages[scene][message];
      current.unit.classList.remove("pending");
      const typing = current.lines[line];
      if (typing) {
        character += 1;
        typing.visual.textContent = typing.text.slice(0, character);
        if (character >= typing.text.length) {
          line += 1;
          character = 0;
        }
        delay = timing.character;
      } else if (message < messages[scene].length - 1) {
        message += 1;
        line = 0;
        character = 0;
        delay = timing.between;
      } else {
        sceneComplete = true;
        delay = scene === panels.length - 1 ? timing.end : timing.scene;
      }
      schedule();
    };
    reduced.addEventListener("change", () => {
      resetScene();
      delay = timing.entrance;
      schedule();
    });
    document.addEventListener("visibilitychange", schedule);
    resetScene();
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (inView !== entry.isIntersecting) {
          inView = entry.isIntersecting;
          schedule();
        }
      },
      { threshold: 0.4 },
    );
    observer.observe(demo);
  }
</script>

<style>
  .memo-demo {
    margin: 0;
    min-width: 0;
  }
  .stream-line {
    position: relative;
  }
  .stream-line :global(.stream-visual) {
    display: none;
  }
  .enhanced .stream-line :global(.stream-source) {
    opacity: 0;
  }
  .enhanced .stream-line :global(.stream-visual) {
    display: block;
    position: absolute;
    inset: 0;
  }
  .enhanced :global(.pending) {
    visibility: hidden;
  }
  .scene-stage {
    display: grid;
    gap: var(--space-8);
  }
  .scene {
    min-width: 0;
  }
  .enhanced .scene-stage {
    gap: 0;
  }
  .enhanced .scene {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 160ms ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .enhanced .scene.active {
    visibility: visible;
    opacity: 1;
  }
  .chat {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .chat > li {
    border-left: 2px solid var(--hairline);
    padding: var(--space-3) var(--space-4);
  }
  .scene-label {
    margin-bottom: var(--space-3);
  }
  /* A saved-report excerpt, set like a sample on a report: typed text in a
     dashed box on the ground, apart from the chat turns around it. */
  .excerpt {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--hairline);
    background: var(--ground);
    font: var(--text-small) / var(--leading-body) var(--font-mono);
  }
  p + .excerpt {
    margin-top: var(--space-3);
  }
  .excerpt > p + p {
    margin-top: var(--space-2);
  }
  .speaker {
    display: block;
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
    margin-bottom: var(--space-2);
  }
  p {
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .enhanced .scene {
      transition: none;
    }
  }
</style>
