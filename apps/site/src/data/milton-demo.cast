[0.146, "o", "\u001b[?2026h\u001b[?25l\u001b[2D\u001b[3B\r\u001b[8A \u001b[3G\u001b[38;5;246mCalled milton (ctrl+o to expand)\u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;231m⏺\u001b[3G\u001b[39mHere's a draft:\u001b[K\r\u001b[2B  \u001b[2m▎\u001b[22m \u001b[3mHi, thanks for asking, but I can't come in on Saturday. Let me know if I can help get things \u001b[23m\u001b[K\r\u001b[1B  \u001b[2m▎\u001b[5G\u001b[22m\u001b[3mready before then.\r\u001b[1B\u001b[23m\u001b[K\r\u001b[2C\u001b[1BI didn't give a reason since you didn't mention one. If\u001b[59Gyou\u001b[63Gwant\u001b[68Gto\u001b[71Gadd\u001b[75Gone,\u001b[80Gor\u001b[83Goffer\u001b[89Ganother\u001b[97Gday,\r\r\n\u001b[3Gtell\u001b[8Gme\u001b[11Gand\u001b[15GI'll\u001b[20Gwork\u001b[25Git\u001b[28Gin.\u001b[32GI\u001b[34Gcan\u001b[38Galso\u001b[43Gmake\u001b[48Git\u001b[51Gmore\u001b[56Gformal\u001b[63Gif\u001b[66Gthis\u001b[71Gis\u001b[74Ggoing\u001b[80Gout\u001b[84Gas\u001b[87Gan\u001b[90Gemail.\r\r\n\r\r\n\u001b[3GMilton\u001b[10G(your\u001b[16Gwriting-memory\u001b[31Gtool)\u001b[37Gis\u001b[40Gconnected\u001b[50Gbut\u001b[54Gdoesn't\u001b[62Ghave\u001b[67Gany\u001b[71Gof\u001b[74Gyour\u001b[79Gwriting\u001b[87Gyet,\u001b[92Gso\u001b[95Gthis\r\r\n\u001b[3Gisn't\u001b[9Gin\u001b[12Gyour\u001b[17Gvoice.\u001b[24GIf\u001b[27Gyou\u001b[31Gpaste\u001b[37Gabout\u001b[43Gfive\u001b[48Gmessages\u001b[57Gyou've\u001b[64Gwritten\u001b[72Gand\u001b[76Gsent,\u001b[82Git\u001b[85Gwill\u001b[90Gkeep\u001b[95Gthem\r\r\n\u001b[3Gas\u001b[6Gexamples\u001b[15Gso\u001b[18Gfuture\u001b[25Gdrafts"]
