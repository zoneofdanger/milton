---
import "@milton/theme/base";
import { faviconLinks, folderMark } from "@milton/theme/brand";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title: string;
  description: string;
  legal?: boolean;
}
const { title, description, legal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/* The forty-link footer, for a company of one. Entries without an href are
   plain text and must not look like links. Privacy and Terms live only here
   on these pages; the legal pages keep the plain footer. */
const footerColumns: {
  heading: string;
  entries: { label: string; href?: string }[];
}[] = [
  { heading: "Product", entries: [{ label: "Milton", href: "/" }] },
  { heading: "Company", entries: [{ label: "Peter" }] },
  { heading: "Careers", entries: [{ label: "No" }] },
  {
    heading: "Resources",
    entries: [
      { label: "Setup guide", href: "/setup" },
      { label: "Source", href: "https://github.com/zoneofdanger/milton" },
    ],
  },
  {
    heading: "Legal",
    entries: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
  { heading: "Status", entries: [{ label: "Filed" }] },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/geist-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Fragment set:html={faviconLinks} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="wrap navigation" aria-label="Main">
        <a class="brand" href="/" aria-label="Milton home">
          <Fragment set:html={folderMark} />
          <span>Milton</span>
        </a>
        <div class="nav-links">
          <a href="/#how-it-works">How it works</a>
          <a href="/#pricing">Pricing</a>
          <a class="button secondary" href="https://app.meetmilton.com/">
            Open Milton
          </a>
        </div>
      </nav>
    </header>
    <main id="main" tabindex="-1" class:list={["wrap", { legal }]}>
      <slot />
    </main>
    <footer class="wrap">
      {!legal && (
        <nav class="footer-grid" aria-label="Footer">
          {footerColumns.map(({ heading, entries }) => (
            <div class="footer-column">
              <p class="eyebrow">{heading}</p>
              <ul>
                {entries.map(({ label, href }) => (
                  <li>
                    {href ? <a href={href}>{label}</a> : <span>{label}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}
      <div class="footer-links">
        <span>© 2026 Zone of Danger, LLC</span>
        {legal && (
          <nav aria-label="Legal">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </nav>
        )}
        <a href="mailto:support@meetmilton.com">
          Contact: support@meetmilton.com
        </a>
      </div>
      {!legal && (
        <p class="footer-aside">
          A small website with strong feelings about punctuation.
        </p>
      )}
    </footer>
    <Analytics />
  </body>
</html>

<style>
  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-10);
  }
  .site-header {
    border-bottom: 1px solid var(--hairline);
  }
  .navigation {
    min-height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-3);
    flex-wrap: wrap;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    font-size: var(--text-small);
  }
  .nav-links > a {
    display: inline-flex;
    min-height: var(--touch-target);
    align-items: center;
  }
  .nav-links > a:not(.button) {
    text-decoration: none;
  }
  .nav-links > a:not(.button):hover {
    text-decoration: underline;
  }
  .legal {
    max-width: 760px;
    padding-block: var(--space-16) 96px;
  }
  .legal :global(h1) {
    font-size: var(--text-page);
    margin: 0 0 var(--space-6);
  }
  .legal :global(h2) {
    font-size: var(--text-title);
    margin: var(--space-8) 0 var(--space-3);
  }
  .legal :global(p) {
    margin: var(--space-4) 0 0;
    line-height: 1.75;
  }
  .legal :global(.updated) {
    margin: var(--space-3) 0 var(--space-8);
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
  }
  footer {
    padding-block: var(--space-6) var(--space-8);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-6);
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-8);
  }
  .footer-grid ul {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .footer-grid li {
    display: flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .footer-grid a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  /* Plain entries: muted, never underlined, no pointer. Links keep the
     site's underline in ink. */
  .footer-grid span {
    color: var(--muted);
    cursor: default;
  }
  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-4);
    font-size: var(--text-caption);
    color: var(--muted);
  }
  .footer-links nav {
    display: flex;
    gap: var(--space-5);
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .footer-links > a {
    margin-left: auto;
  }
  .footer-aside {
    margin: var(--space-3) 0 0;
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
  }
  @media (max-width: 600px) {
    .wrap {
      padding-inline: var(--space-5);
    }
    .navigation {
      gap: var(--space-2) var(--space-5);
    }
    .nav-links {
      gap: var(--space-3);
      font-size: var(--text-caption);
    }
    .nav-links .button {
      padding-inline: var(--space-4);
      font-size: var(--text-caption);
    }
    .legal {
      padding-block: var(--space-10) 56px;
    }
    .footer-links > a {
      margin-left: 0;
    }
  }
  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Phones: six short rows, heading then entries, in the same order. */
  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: var(--space-4);
    }
    .footer-column {
      display: grid;
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: center;
      gap: var(--space-4);
    }
    .footer-grid ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-5);
      margin: 0;
    }
  }
</style>
