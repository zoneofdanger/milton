---
import SiteLayout from "../layouts/SiteLayout.astro";
import AssistantSetup from "../components/AssistantSetup.astro";
import TryItBox from "../components/TryItBox.astro";

/* The page's swappable lines, one place each. */
const copy = {
  price: "30 days free, then $5.01 a month. No card.",
  priceTail: "",
  dateLine: "2026. The cover sheet is still required.",
  markOne: [
    { label: "Urgent", ticked: true },
    { label: "For review", ticked: false },
    { label: "Please comment", ticked: false },
    { label: "Please stop", ticked: true },
  ],
  steps: [
    { text: "Connect Milton to your AI.", initials: "You" },
    { text: "Ask for a draft. Your AI pulls your file first.", initials: "AI" },
    { text: "Fix it until it’s yours. The fixes go on file.", initials: "You" },
  ],
  // Stays empty until setup can do this; when set, it is the slip's second row.
  onboardingStep: { text: "", initials: "AI" },
  fileCaption: "Personnel file",
  signOff: "We did not build superintelligence. We built a filing department.",
  testimonial: {
    quote:
      "I already share a name with a singer. I’d rather not share a voice with a clanker.",
    name: "Michael Bolton",
    title: "Senior Founding AI Forward Deployed Product Engineer",
  },
};

const [connect, ...rest] = copy.steps;
const steps = [connect!, copy.onboardingStep, ...rest].filter(
  (step) => step.text,
);

const guides = [
  { label: "Claude", href: "/setup#claude" },
  { label: "ChatGPT", href: "/setup#chatgpt" },
  { label: "Claude Code", href: "/setup#claude-code" },
  { label: "Codex", href: "/setup#codex" },
  { label: "Cursor", href: "/setup#cursor" },
  { label: "and more", href: "/setup" },
];
---

<SiteLayout
  title="Stop sounding like AI. | Milton"
  description="Milton makes your AI write like you."
>
  <section class="hero" aria-labelledby="headline">
    <div class="hero-text">
      <h1 id="headline">Stop sounding like AI.</h1>
      <p class="intro">Milton makes your AI write like you.</p>
    </div>
    <div class="hero-cta">
      <a class="button" href="https://app.meetmilton.com/login" data-try-it-cta>
        Try Milton free <span aria-hidden="true">↗</span>
      </a>
      <p class="small-note">
        {copy.price}
        {copy.priceTail && ` ${copy.priceTail}`}
      </p>
    </div>
  </section>

  <TryItBox fileCaption={copy.fileCaption} />

  <div class="work">
    <section class="slip-wrap" id="how-it-works" aria-labelledby="how-heading">
      <h2 class="visually-hidden" id="how-heading">
        How it works
      </h2>
      <figure class="sheet slip" aria-labelledby="slip-title">
        <div class="sheet-bar">
          <span id="slip-title">Interoffice routing slip</span>
        </div>
        <dl class="slip-fields">
          <div>
            <dt>To:</dt>
            <dd>Your AI</dd>
          </div>
          <div>
            <dt>From:</dt>
            <dd>You</dd>
          </div>
          <div>
            <dt>Re:</dt>
            <dd>How you write</dd>
          </div>
          <div>
            <dt>Date:</dt>
            <dd>{copy.dateLine}</dd>
          </div>
        </dl>
        <div class="mark-one">
          <span class="mark-label" id="mark-one-label">
            Mark one
          </span>
          <ul aria-labelledby="mark-one-label">
            {copy.markOne.map(({ label, ticked }) => (
              <li>
                <span class="tick-box" aria-hidden="true">
                  {ticked ? "✕" : ""}
                </span>
                {label}
                {ticked && <span class="visually-hidden">, ticked</span>}
              </li>
            ))}
          </ul>
        </div>
        <ol class="slip-rows">
          {steps.map(({ text, initials }) => (
            <li class="slip-row">
              <span class="slip-box" aria-hidden="true">
                ✓
              </span>
              <p class="slip-text">{text}</p>
              <p class="slip-initials">
                <span class="slip-initials-label">Initials</span>
                <span class="slip-initials-value">{initials}</span>
              </p>
            </li>
          ))}
        </ol>
      </figure>
      <span class="filed" aria-hidden="true">
        Filed
      </span>
    </section>
    <div class="distribution">
      <p class="eyebrow" id="distribution-label">
        Distribution
      </p>
      <nav aria-labelledby="distribution-label">
        <ul>
          {guides.map(({ label, href }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <AssistantSetup />
    </div>
  </div>

  <section class="faq" aria-labelledby="faq-heading">
    <h2 id="faq-heading">
      Couldn’t I just use a Markdown file in a synced folder?
    </h2>
    <p class="faq-answer">
      Yes. Milton handles the connections, keeps memos as you go and picks the
      finals for the job. We added a cover sheet and made it a recurring
      expense.
    </p>
    <div class="questions">
      <details>
        <summary>What does Milton keep, and what does it never touch?</summary>
        <p>
          A memo each time you accept a final: your AI’s first draft, your
          final, one-line tweaks for what you made it change, and a one-line
          summary of the situation. Plus your cover sheet, in your words. Milton
          never rewrites any of it. It does not read your inbox, files, or
          conversations; it gets only what your AI sends. Forget a memo on your
          TPS page, or turn off Keep memos and delete them all in Memo settings.
        </p>
      </details>
      <details>
        <summary>Can I take my writing and leave?</summary>
        <p>
          We won’t take your stapler. The source is public, and you can run
          Milton yourself. Download your cover sheet, tweaks and every final as
          TPS.md. Disconnect an AI and Milton refuses its future reads and saves
          immediately; it cannot erase copies the AI already read. We’d prefer
          you keep paying us, but apparently that’s not a retention strategy.
        </p>
        <p>
          <a href="https://github.com/zoneofdanger/milton">Read the source ↗</a>
        </p>
      </details>
      <details>
        <summary>Which AIs can I connect?</summary>
        <p>
          Milton uses MCP. Your AI needs support for a remote MCP server,
          sign-in, and both reading and saving through tools. Availability
          depends on your AI, plan, and workspace settings.{" "}
          <a href="/setup">Check the setup guide before signing up.</a>
        </p>
      </details>
      <details>
        <summary>Will my AI always write like me?</summary>
        <p>
          Not always. Milton keeps your cover sheet, finals and tweaks
          available. A standing instruction asks your AI to read them before
          writing, but the AI still decides when to read and how to follow them.
          Ask it to verify the read before relying on the result.
        </p>
      </details>
      <details id="why-this-exists">
        <summary>Why does this exist?</summary>
        <p>
          Peter wanted his AIs to write like him. Somehow he ended up building
          them a filing department.
        </p>
        <p class="eyebrow">## An imaginary productivity review</p>
        <p>
          <strong>Reviewer:</strong> Walk us through a typical session.
        </p>
        <p>
          <strong>Me:</strong> First I explain how I like to work. Then I remind
          it. Then it apologizes. Then I explain that I don’t need the apology.
        </p>
        <p>
          <strong>Reviewer:</strong> How much actual work gets done?
        </p>
        <p>
          <strong>Me:</strong> About fifteen minutes.
        </p>
      </details>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-heading">
    <div class="closing-main">
      <h2 id="closing-heading">Did you get the memo?</h2>
      <a class="button" href="https://app.meetmilton.com/login">
        Try Milton free <span aria-hidden="true">↗</span>
      </a>
      <p class="small-note">{copy.signOff}</p>
    </div>
    <figure
      class="sheet message"
      id="employee-testimonial"
      aria-label="Fictional employee testimonial"
    >
      <div class="sheet-bar">
        <span>While you were out</span>
      </div>
      <dl>
        <div class="message-row">
          <dt>From</dt>
          <dd>{copy.testimonial.name}</dd>
        </div>
        <div class="message-row">
          <dt>Of</dt>
          <dd>{copy.testimonial.title}</dd>
        </div>
        <div class="message-row">
          <dt>Message</dt>
          <dd>“{copy.testimonial.quote}”</dd>
        </div>
      </dl>
      <p class="message-ticks" aria-hidden="true">
        <span>
          <span class="tick-box">✕</span>Telephoned
        </span>
        <span>
          <span class="tick-box"></span>Please call
        </span>
        <span>
          <span class="tick-box"></span>Will call again
        </span>
      </p>
    </figure>
  </section>
</SiteLayout>

<style>
  :where(h1, h2, p, figure, dl, dd, ul, ol) {
    margin: 0;
  }
  /* No paragraph ends on a lone word. Scoped to this page, so the try-it
     box's emails keep plain wrapping. */
  p {
    text-wrap: pretty;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .eyebrow {
    color: var(--muted);
  }
  /* Decorative tick squares on the slip and the phone message. */
  .tick-box {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 14px;
    height: 14px;
    border: 1px solid var(--ink);
    font: 11px / 1 var(--font-mono);
  }

  /* Hero: one band on the ground. The headline and intro at the left; the
     button and price at the right, until the band is too narrow for both. */
  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: 28px;
  }
  h1 {
    font-size: clamp(2.375rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .intro {
    margin-top: var(--space-2);
    font-size: var(--text-subtitle);
    line-height: var(--leading-label);
  }
  .hero-cta {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
  }
  @media (min-width: 1080px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: var(--space-8);
    }
    h1 {
      white-space: nowrap;
    }
    /* The button's top sits level with the top of the headline's capitals. */
    .hero-cta {
      justify-items: end;
      margin-top: calc(clamp(2.375rem, 5vw, 4rem) * 0.16);
      text-align: right;
    }
  }
  .hero {
    margin-bottom: var(--space-8);
  }

  /* Below the folder: the routing slip with its distribution list. */
  .work {
    display: grid;
    grid-template-columns: minmax(0, 720px) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    margin-top: 96px;
  }
  .slip-wrap {
    position: relative;
    padding-bottom: var(--space-6);
  }
  .slip-fields {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3) var(--sheet-padding);
    border-bottom: 1px solid var(--ink);
    font: var(--text-small) / var(--leading-label) var(--font-mono);
  }
  .slip-fields > div {
    display: flex;
    gap: var(--space-2);
  }
  /* The date takes its own line. The dot between the other fields is
     decoration, not read aloud. */
  .slip-fields > div:last-child {
    flex-basis: 100%;
  }
  .slip-fields > div:not(:nth-last-child(-n + 2))::after {
    content: "·";
    content: "·" / "";
    margin-left: var(--space-2);
    color: var(--muted);
  }
  .slip-fields dt {
    color: var(--muted);
  }
  .mark-one {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--sheet-padding);
    border-bottom: 1px solid var(--ink);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .mark-label {
    color: var(--muted);
  }
  .mark-one ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }
  .mark-one li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
  }
  .slip-rows {
    padding: 0;
    list-style: none;
    counter-reset: slip;
  }
  .slip-row {
    counter-increment: slip;
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) 112px;
    grid-template-areas: "num box text initials";
    align-items: stretch;
    border-bottom: 1px solid var(--hairline);
  }
  .slip-row:last-child {
    border-bottom: 0;
  }
  .slip-row::before {
    grid-area: num;
    content: "0" counter(slip);
    align-self: center;
    padding-inline: var(--sheet-padding) var(--space-4);
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
  }
  .slip-box {
    grid-area: box;
    align-self: center;
    display: inline-grid;
    place-items: center;
    width: var(--space-6);
    height: var(--space-6);
    border: 1px solid var(--ink);
    background: var(--surface);
    font: var(--text-body) / 1 var(--font-mono);
  }
  .slip-text {
    grid-area: text;
    align-self: center;
    padding: var(--space-4) var(--space-6) var(--space-4) var(--space-5);
  }
  .slip-initials {
    grid-area: initials;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px var(--space-4);
    border-left: 1px solid var(--hairline);
  }
  .slip-initials-label {
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .slip-initials-value {
    font: italic var(--text-lead) / var(--leading-heading) var(--font-form);
  }
  /* A rubber stamp across the slip's lower edge, left of the initials and
     right of the last step's words. Decorative only. */
  .filed {
    position: absolute;
    right: 150px;
    bottom: -6px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid currentColor;
    outline: 1px solid currentColor;
    outline-offset: 4px;
    color: var(--ink);
    opacity: 0.45;
    transform: rotate(-8deg);
    font: 1.875rem / 1 var(--font-mono);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    pointer-events: none;
    user-select: none;
  }
  .distribution {
    display: grid;
    justify-items: start;
    gap: var(--space-2);
    padding-top: 4px;
    font-size: 0.9375rem;
  }
  .distribution ul {
    padding: 0;
    list-style: none;
  }
  .distribution a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
  }
  .distribution :global(.assistant-setup) {
    margin-top: var(--space-3);
  }

  /* Questions: the one most asked, open as text, then a ruled list. */
  .faq {
    max-width: 860px;
    margin-top: 72px;
  }
  .faq h2 {
    font-size: clamp(1.375rem, 2.35vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .faq-answer {
    max-width: 66ch;
    margin-top: 14px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
  }
  .questions {
    margin-top: 28px;
    font-size: 0.9375rem;
  }
  .questions details {
    border-top: 1px solid var(--hairline);
  }
  .questions details:last-child {
    border-bottom: 1px solid var(--hairline);
  }
  .questions summary {
    display: list-item;
    min-height: var(--touch-target);
    padding-block: 10px;
    cursor: pointer;
    font-weight: 500;
  }
  .questions details > p {
    padding: 0 0 14px 18px;
    color: var(--muted);
  }

  /* Closing: the question again, the button, and a phone message slip. */
  .closing {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-12);
    align-items: start;
    margin-top: 96px;
    padding-bottom: var(--space-16);
  }
  .closing-main {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }
  .closing h2 {
    font-size: clamp(2.125rem, 4.375vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }
  .message {
    --sheet-padding: var(--space-5);
  }
  .message-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: var(--space-2);
    align-items: baseline;
    padding: 10px var(--sheet-padding);
    border-bottom: 1px solid var(--hairline);
  }
  .message-row dt {
    color: var(--muted);
    font: var(--text-caption) / var(--leading-label) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .message-row dd {
    font-size: 0.9375rem;
    line-height: var(--leading-label);
  }
  .message-ticks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-4);
    padding: var(--space-3) var(--sheet-padding) 14px;
    font: 11px / var(--leading-label) var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .message-ticks > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .message-ticks .tick-box {
    width: 13px;
    height: 13px;
    font-size: 10px;
  }

  @media (max-width: 1079px) {
    .work {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .distribution {
      display: block;
    }
    .distribution ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 14px;
    }
  }
  @media (max-width: 767px) {
    .hero {
      gap: 18px;
      padding-top: 22px;
    }
    .intro {
      font-size: 1.0625rem;
    }
    .hero-cta {
      justify-items: stretch;
    }
    .hero {
      margin-bottom: var(--space-6);
    }
    .work {
      margin-top: 56px;
    }
    .slip-fields {
      flex-direction: column;
      gap: 0;
    }
    .slip-fields > div:not(:last-child)::after {
      display: none;
    }
    .slip-row {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "box text"
        "box initials";
      column-gap: var(--space-4);
      padding: var(--space-4) var(--sheet-padding);
    }
    .slip-row::before {
      display: none;
    }
    .slip-box {
      align-self: start;
    }
    .slip-text {
      padding: 0;
    }
    .slip-text::before {
      content: "0" counter(slip) " ";
      color: var(--muted);
      font: var(--text-caption) / var(--leading-label) var(--font-mono);
    }
    .slip-initials {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-3);
      margin-top: var(--space-3);
      padding: var(--space-2) 0 0;
      border-left: 0;
      border-top: 1px dashed var(--hairline);
    }
    .filed {
      right: var(--space-4);
      bottom: -8px;
      font-size: var(--text-subtitle);
    }
    .faq {
      margin-top: 56px;
    }
    .faq-answer {
      font-size: var(--text-body);
    }
    .closing {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      margin-top: 64px;
      padding-bottom: var(--space-10);
    }
    .closing-main .button {
      justify-self: stretch;
    }
    .message-row {
      grid-template-columns: 72px minmax(0, 1fr);
    }
  }
</style>
