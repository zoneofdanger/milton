{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "milton-app",
    "annotations": {
      "run.googleapis.com/ingress": "internal-and-cloud-load-balancing",
      "run.googleapis.com/minScale": "1",
      "run.googleapis.com/maxScale": "3"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "run.googleapis.com/execution-environment": "gen2"
        }
      },
      "spec": {
        "serviceAccountName": "milton-app@milton-510506.iam.gserviceaccount.com",
        "containerConcurrency": 40,
        "timeoutSeconds": 60,
        "containers": [
          {
            "image": "us-east4-docker.pkg.dev/milton-510506/milton/runtime@sha256:2eb49f6eb9ef107fac21bcc2298ddade458a4b28350ff536ffa0102c3fbae395",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "env": [
              {
                "name": "MILTON_SERVICE",
                "value": "app"
              },
              {
                "name": "MILTON_ENCRYPTED_ENV_FILE",
                "value": "/run/milton/.env"
              },
              {
                "name": "DOTENV_PRIVATE_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "milton-app-key",
                    "key": "1"
                  }
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "environment",
                "mountPath": "/run/milton"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "environment",
            "secret": {
              "secretName": "milton-app-env",
              "items": [
                {
                  "key": "1",
                  "path": ".env"
                }
              ]
            }
          }
        ]
      }
    },
    "traffic": [
      {
        "latestRevision": true,
        "percent": 100
      }
    ]
  }
}
