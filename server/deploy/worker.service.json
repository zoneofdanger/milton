{
  "apiVersion": "serving.knative.dev/v1",
  "kind": "Service",
  "metadata": {
    "name": "milton-worker",
    "annotations": {
      "run.googleapis.com/ingress": "internal",
      "run.googleapis.com/minScale": "0",
      "run.googleapis.com/maxScale": "1"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "run.googleapis.com/execution-environment": "gen2"
        }
      },
      "spec": {
        "serviceAccountName": "milton-worker@milton-510506.iam.gserviceaccount.com",
        "containerConcurrency": 1,
        "timeoutSeconds": 180,
        "containers": [
          {
            "image": "us-east4-docker.pkg.dev/milton-510506/milton/runtime@sha256:a370b7c3f414560141d345e31ca84c329c5ad51c692eb526af6d16329feddd62",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "env": [
              {
                "name": "MILTON_SERVICE",
                "value": "worker"
              },
              {
                "name": "MILTON_ENCRYPTED_ENV_FILE",
                "value": "/run/milton/.env"
              },
              {
                "name": "DOTENV_PRIVATE_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "milton-worker-key",
                    "key": "1"
                  }
                }
              }
            ],
            "volumeMounts": [
              {
                "name": "environment",
                "mountPath": "/run/milton"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "environment",
            "secret": {
              "secretName": "milton-worker-env",
              "items": [
                {
                  "key": "4",
                  "path": ".env"
                }
              ]
            }
          }
        ]
      }
    },
    "traffic": [
      {
        "latestRevision": true,
        "percent": 100
      }
    ]
  }
}
