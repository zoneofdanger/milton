        "memos_audience": {
          "name": "memos_audience",
          "value": "\"memos\".\"audience\" IS NULL OR (char_length(\"memos\".\"audience\") BETWEEN 1 AND 100 AND \"memos\".\"audience\" = btrim(\"memos\".\"audience\") AND \"memos\".\"audience\" !~ '[[:cntrl:]]')"
