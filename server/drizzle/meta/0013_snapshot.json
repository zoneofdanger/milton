        "memos_first_draft": {
          "name": "memos_first_draft",
          "value": "\"memos\".\"first_draft_state\" IN ('kept','missing','none') AND (\"memos\".\"first_draft\" IS NOT NULL) = (\"memos\".\"first_draft_state\" = 'kept') AND (\"memos\".\"mode\" IS NULL) = (\"memos\".\"first_draft_state\" = 'none') AND (\"memos\".\"rounds\" IS NULL) = (\"memos\".\"first_draft_state\" = 'none') AND (\"memos\".\"change\" IS NULL OR \"memos\".\"first_draft_state\" = 'kept')"
